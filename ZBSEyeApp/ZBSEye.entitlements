<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NO com.apple.security.app-sandbox: SCK full-display + cross-app AX + local server
	     are incompatible with the App Sandbox. Hardened Runtime without sandbox (the recorder class like Rewind). -->
	<!-- Microphone under Hardened Runtime (step 10): audio capture for on-device transcription. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Data-protection Keychain items require a provisioned access group even
	     for a Developer ID app distributed outside the Mac App Store. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
