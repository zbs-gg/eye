    "Anthropic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic"
          }
        }
      }
    },
    "Ask a question in plain language — ZBS Eye will find the relevant moments in your screen and conversation history and answer from them, with links to the sources.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос обычными словами — ZBS Eye найдёт подходящие моменты в истории экрана и разговоров, ответит по ним и даст ссылки на источники."
          }
        }
      }
    },
    "Ask, Daily Insights, summaries, and labels use this one local pair.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спросить», «Инсайты дня», дайджесты и метки используют эту локальную пару."
          }
        }
      }
    },
    "Ask, Daily Insights, summaries, and labels use this pair. History excerpts go only to the recipient you approved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спросить», «Инсайты дня», дайджесты и метки используют эту пару. Фрагменты истории уходят только одобренному вами получателю."
          }
        }
      }
    },
    "Built-in local AI is managed by the hero above.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная локальная модель управляется в большом блоке выше."
          }
        }
      }
    },
