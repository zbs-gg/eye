      }
    },
    "Automatic cleanup is stopped for this run, but Eye could not save the new media limit. Try again before restarting.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая очистка остановлена до завершения Eye, но новый лимит медиа не удалось сохранить. Повторите до перезапуска."
          }
