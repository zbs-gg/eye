    },
    "Something not working? Describe it and have your own agent fix it — or file a GitHub issue.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не работает? Опишите проблему своему агенту, чтобы он помог её исправить, или создайте issue на GitHub."
